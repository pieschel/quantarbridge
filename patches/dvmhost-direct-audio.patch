+
+bool BaseNetwork::enqueueReceiveRecord(RingBuffer<uint8_t>& ring, const uint8_t* payload,
+    uint32_t length, uint32_t streamId)
+{
+    if (payload == nullptr || length == 0U || length > 512U || !ring.hasSpace(length + 6U)) {
+        ring.clear();
+        return false;
+    }
+    uint8_t record[518U];
+    record[0U] = (uint8_t)(streamId >> 24);
+    record[1U] = (uint8_t)(streamId >> 16);
+    record[2U] = (uint8_t)(streamId >> 8);
+    record[3U] = (uint8_t)streamId;
+    record[4U] = (uint8_t)(length >> 8);
+    record[5U] = (uint8_t)length;
+    ::memcpy(record + 6U, payload, length);
+    // One ring write is essential: payload and its stream ID cannot separate.
+    if (!ring.addData(record, length + 6U)) {
+        ring.clear();
+        return false;
+    }
+    return true;
+}
+
+UInt8Array BaseNetwork::readReceiveRecord(RingBuffer<uint8_t>& ring, bool& ret,
+    uint32_t& length, uint32_t& streamId)
+{
+    ret = false;
+    length = 0U;
+    streamId = 0U;
+    if (ring.isEmpty())
+        return nullptr;
+    uint8_t header[6U];
+    if (ring.dataSize() < 6U || !ring.peek(header, 6U)) {
+        ring.clear();
+        return nullptr;
+    }
+    const uint32_t size = ((uint32_t)header[4U] << 8) | header[5U];
+    if (size == 0U || size > 512U || ring.dataSize() < size + 6U) {
+        ring.clear();
+        return nullptr;
+    }
+    UInt8Array payload = std::make_unique<uint8_t[]>(size);
+    if (!ring.get(header, 6U) || !ring.get(payload.get(), size)) {
+        ring.clear();
+        return nullptr;
+    }
+    streamId = ((uint32_t)header[0U] << 24) | ((uint32_t)header[1U] << 16) |
+        ((uint32_t)header[2U] << 8) | header[3U];
+    length = size;
+    ret = true;
+    return payload;
+}
