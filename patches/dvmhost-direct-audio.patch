+void unpack(const uint8_t* raw, Word16* frame)
+{
+    const int widths[8] = {12,12,12,12,11,11,11,7};
+    int bit = 0;
+    for (int k = 0; k < 8; ++k) {
+        frame[k] = 0;
+        for (int i = 0; i < widths[k]; ++i, ++bit)
+            frame[k] = static_cast<Word16>((frame[k] << 1) | ((raw[bit / 8] >> (7 - bit % 8)) & 1));
+    }
+}
+void pack(const Word16* frame, uint8_t* raw)
+{
+    const int widths[8] = {12,12,12,12,11,11,11,7};
+    std::memset(raw, 0, 11);
+    int bit = 0;
+    for (int k = 0; k < 8; ++k)
+        for (int i = widths[k] - 1; i >= 0; --i, ++bit)
+            raw[bit / 8] |= static_cast<uint8_t>(((frame[k] >> i) & 1) << (7 - bit % 8));
+}
+bool validModel(const mbe_parms& m)
+{
+    if (m.L < 9 || m.L > 56 || !std::isfinite(m.w0) || m.w0 <= 0.0f ||
+        !std::isfinite(m.gamma))
+        return false;
+    for (int l = 1; l <= m.L; ++l)
+        if (!std::isfinite(m.Ml[l]) || m.Ml[l] < 0.0f ||
+            !std::isfinite(m.log2Ml[l]) || (m.Vl[l] != 0 && m.Vl[l] != 1))
+            return false;
+    return true;
+}
