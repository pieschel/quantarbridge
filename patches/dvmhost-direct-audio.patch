index 00000000..51453c15
--- /dev/null
+++ b/src/vocoder/P25ToAmbeFloat.h
@@ -0,0 +1,73 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+extern "C" {
+#include "vocoder/mbe.h"
+}
+
+// Stateful clear-P25 parameter to AMBE conversion; disabled until configured.
+namespace vocoder {
+class P25ToAmbeFloat {
+public:
+    struct Config {
+        float gain = 1.5f;
+        float scale = 0.9f;
+        float cutoffHz = 3300.0f;
+        float amplitudeFloor = 1.0e-6f;
+        float deessMaxDb = 0.0f;
+        float deessStartHz = 2200.0f;
+        float deessFullHz = 3400.0f;
+    };
+    enum class Status {
+        Disabled, Voice, Silence, Concealed, Muted,
+        RejectedSize, RejectedPitch, RejectedEncrypted, RejectedConfig, RejectedModel
+    };
+    struct Frame {
+        std::array<uint8_t, 9> bytes{};
+        Status status = Status::Disabled;
+        bool hasFrame() const {
+            return status == Status::Voice || status == Status::Silence ||
+                status == Status::Concealed || status == Status::Muted;
+        }
+    };
+
+    P25ToAmbeFloat();
+    explicit P25ToAmbeFloat(Config config);
+    void setEnabled(bool enabled);
+    bool enabled() const { return m_enabled; }
+    void resetCall();
+    // encrypted comes from the owning call/LC classification; no decryption here.
+    Status convert(const uint8_t* raw88, std::size_t length, bool encrypted, Frame& out);
+    // Caller chooses this explicitly for a lost/rejected expected voice frame.
+    // Repeat at most three models (60 ms), then emit canonical silence.
+    Status concealErasure(Frame& out);
+    // Canonical silence also advances the target predictor; used for final slot padding.
+    Status silenceFrame(Frame& out);
+    // Transport idle: advance only the emitted AMBE predictor. Preserve the
+    // continuing source call and cached speech/erasure state for the next LDU.
+    Status idleFrame(Frame& out);
+
+private:
+    struct Model {
+        int harmonics = 0;
+        int16_t pitch = 0;
+        std::array<int16_t, 56> voicing{};
+        std::array<float, 56> amplitudes{};
+        std::array<float, 56> voicingWeights{};
+    };
+    Config m_config;
+    bool m_enabled = false;
+    bool m_configValid = false;
+    bool m_haveLast = false;
+    unsigned m_erasureCount = 0;
+    Model m_last;
+    mbe_parms m_source{}, m_sourcePrevious{}, m_sourceEnhanced{};
+    mbe_parms m_target{}, m_targetPrevious{}, m_targetEnhanced{};
+    static Status clear(Frame& out, Status status);
+    void resetSource();
+    bool encodeModel(const Model& model, Frame& out);
+    Status silence(Frame& out, Status status);
+};
+
+} // namespace vocoder
