new file mode 100644
index 00000000..8842dc81
--- /dev/null
+++ b/src/bridge/P25ImbeSync.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef BRIDGE_P25_IMBE_SYNC_H
+#define BRIDGE_P25_IMBE_SYNC_H
+
+#include <cstdint>
+
+namespace bridge {
+// Synchronization bit b[L+2] alternates across the nine voice words of each
+// LDU: LDU1 starts with zero, LDU2 with one. The other 87 IMBE bits and all
+// non-voice bytes are untouched. Existing LDU/call position owns the phase.
+inline void stampP25ImbeSync(uint8_t* ldu, bool ldu1, bool directReverse, bool clear)
+{
+    if (ldu == nullptr || !directReverse || !clear)
+        return;
+    const unsigned offsets[9] = {10U, 26U, 55U, 80U, 105U, 130U, 155U, 180U, 204U};
+    const unsigned first = ldu1 ? 0U : 1U;
+    for (unsigned i = 0; i < 9U; ++i) {
+        uint8_t& last = ldu[offsets[i] + 10U];
+        last = static_cast<uint8_t>((last & 0xFEU) | ((first + i) & 1U));
+    }
+}
+}
+
+#endif
