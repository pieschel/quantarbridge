+/* Flush pending direct AMBE speech before end padding can replace its buffer. */
+void HostBridge::finishDirectP25ToDmr(uint32_t srcId, uint32_t dstId)
+{
+    if (!m_directP25ToAmbeEnabled || m_p25ToAmbeFloat == nullptr || m_txMode != TX_MODE_DMR)
