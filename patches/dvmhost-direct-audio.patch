diff --git a/src/vocoder/P25ToAmbeFloat.cpp b/src/vocoder/P25ToAmbeFloat.cpp
new file mode 100644
index 00000000..ada7dab8
--- /dev/null
+++ b/src/vocoder/P25ToAmbeFloat.cpp
@@ -0,0 +1,157 @@
+#include "P25ToAmbeFloat.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+// Existing AMBE quantizer, copied for review with float-amplitude access and
+// numerical log guard only. This converter calls no PCM synthesis or analysis.
+#include "P25ToAmbeFloatQuantizer.inc"
+
+namespace vocoder {
+
+namespace {
+constexpr std::array<uint8_t, 9> SILENCE = {
+    0xb9, 0xe8, 0x81, 0x52, 0x61, 0x73, 0x00, 0x2a, 0x6b
+};
+float magnitude(float hz, float cutoff) {
+    if (cutoff <= 0) return 1;
+    const double t = std::tan(M_PI * hz / 8000.0) / std::tan(M_PI * cutoff / 8000.0);
+    return static_cast<float>(1.0 / std::sqrt(1.0 + t*t*t*t));
+}
+}
+
+P25ToAmbeFloat::P25ToAmbeFloat() : P25ToAmbeFloat(Config{}) {}
+P25ToAmbeFloat::P25ToAmbeFloat(Config config) : m_config(config) {
+    m_configValid = std::isfinite(config.gain) && std::isfinite(config.scale) &&
+        config.scale > 0 && std::isfinite(config.cutoffHz) &&
+        (config.cutoffHz == 0 || (config.cutoffHz > 0 && config.cutoffHz < 4000)) &&
+        std::isfinite(config.amplitudeFloor) && config.amplitudeFloor > 0 &&
+        std::isfinite(config.deessMaxDb) && config.deessMaxDb >= 0 && config.deessMaxDb <= 2 &&
+        std::isfinite(config.deessStartHz) && std::isfinite(config.deessFullHz) &&
+        config.deessStartHz >= 2200 && config.deessFullHz > config.deessStartHz &&
+        config.deessFullHz < 4000;
+    resetCall();
+}
+void P25ToAmbeFloat::resetSource() {
+    m_source = {}; m_sourcePrevious = {}; m_sourceEnhanced = {};
+    mbe_initMbeParms(&m_source, &m_sourcePrevious, &m_sourceEnhanced);
+}
+void P25ToAmbeFloat::resetCall() {
+    resetSource();
+    m_target = {}; m_targetPrevious = {}; m_targetEnhanced = {};
+    mbe_initMbeParms(&m_target, &m_targetPrevious, &m_targetEnhanced);
+    m_haveLast = false; m_erasureCount = 0; m_last = {};
+}
+void P25ToAmbeFloat::setEnabled(bool enabled) {
+    if (enabled != m_enabled) { resetCall(); m_enabled = enabled; }
+}
+P25ToAmbeFloat::Status P25ToAmbeFloat::clear(Frame& out, Status status) {
+    out.bytes.fill(0); out.status = status; return status;
+}
+bool P25ToAmbeFloat::encodeModel(const Model& in, Frame& out) {
+    if (in.harmonics < 9 || in.harmonics > 56) return false;
+    const int count = sizeof(b0_lookup) / sizeof(b0_lookup[0]);
+    int index = (in.pitch >> 5) - 159, steps = 0;
+    if (index < 0 || index >= count) return false;
+    while (static_cast<int>(AmbeLtable[b0_lookup[index]]) != in.harmonics) {
+        index += AmbeLtable[b0_lookup[index]] < in.harmonics ? 1 : -1;
+        if (index < 0 || index >= count || ++steps > count) return false;
+    }
+    IMBE_PARAM model{};
+    model.num_harms = in.harmonics; model.ref_pitch = in.pitch;
+    for (int i = 0; i < in.harmonics; ++i) {
+        const double power = static_cast<double>(in.amplitudes[i]) * in.amplitudes[i];
+        if (!std::isfinite(in.amplitudes[i]) || in.amplitudes[i] < 0 ||
+            power > std::numeric_limits<float>::max()) return false;
+        model.v_uv_dsn[i] = in.voicing[i];
+    }
+    // Transactional target predictor: commit only a complete emitted word.
+    mbe_parms target = m_target, previous = m_targetPrevious;
+    int b[9] = {};
+    encodeAMBEFloat(&model, in.amplitudes.data(), in.voicingWeights.data(), m_config.amplitudeFloor,
+        b, &target, &previous, m_config.gain);
+    uint8_t bits[49] = {}, packed[9] = {};
+    encode49bit(bits, b);
+    for (int i = 0; i < 49; ++i) packed[i/8] |= bits[i] << (7-i%8);
+    encodeDmrAMBE(packed, out.bytes.data());
+    m_target = target; m_targetPrevious = previous;
+    return true;
+}
+P25ToAmbeFloat::Status P25ToAmbeFloat::silence(Frame& out, Status status) {
+    // Native AMBE class-2 renders comfort noise but retains the previous
+    // speech coder predictor (L, gamma and log2Ml). These are the only
+    // previous-state fields consumed by encodeAMBEFloat. Do not equate this
+    // projection with the receiver's changing render flags/class/phase.
+    out.bytes = SILENCE; out.status = status; return status;
+}
+P25ToAmbeFloat::Status P25ToAmbeFloat::convert(
+    const uint8_t* raw88, std::size_t length, bool encrypted, Frame& out) {
+    clear(out, Status::Disabled);
+    if (!m_enabled) return out.status;
+    if (!m_configValid) return clear(out, Status::RejectedConfig);
+    if (encrypted) { resetCall(); return clear(out, Status::RejectedEncrypted); }
+    if (raw88 == nullptr || length != 11) return clear(out, Status::RejectedSize);
+    char bits[88];
+    for (int i = 0; i < 88; ++i) bits[i] = (raw88[i/8] >> (7-i%8)) & 1;
+    int b0 = 0;
+    for (int i = 0; i < 6; ++i) b0 = (b0 << 1) | bits[i];
+    b0 = (b0 << 2) | (bits[85] << 1) | bits[86];
+    if (b0 >= 216 && b0 <= 219) {
+        resetSource(); m_haveLast = false; m_erasureCount = 0;
+        return silence(out, Status::Silence);
+    }
+    if (b0 > 207) return clear(out, Status::RejectedPitch);
+    // Rejected input must not partially alter spectral predictor history.
+    mbe_parms source = m_source, previous = m_sourcePrevious;
+    if (mbe_decodeImbe4400Parms(bits, &source, &previous) != 0)
+        return clear(out, Status::RejectedModel);
+    Model model; model.harmonics = source.L;
+    model.pitch = static_cast<int16_t>(std::max(5088, std::min(31520, b0*128+5056)));
+    if (model.harmonics < 9 || model.harmonics > 56)
+        return clear(out, Status::RejectedModel);
+    for (int i = 0; i < model.harmonics; ++i) {
+        model.voicing[i] = source.Vl[i+1];
+        const float hz = static_cast<float>((i+1)*8000.0 / (static_cast<double>(model.pitch)/256.0));
+        model.amplitudes[i] = 4.0f * source.Ml[i+1] * m_config.scale * magnitude(hz, m_config.cutoffHz);
+        // Keep pitch and the selected AMBE voicing codebook independent of de-essing.
+        model.voicingWeights[i] = model.amplitudes[i];
+        if (m_config.deessMaxDb > 0 && model.voicing[i] == 0) {
+            const float sourceHz = source.w0 * static_cast<float>(i+1) * 8000.0f / static_cast<float>(2.0 * M_PI);
+            float t = (sourceHz - m_config.deessStartHz) / (m_config.deessFullHz - m_config.deessStartHz);
+            t = std::max(0.0f, std::min(1.0f, t));
+            t = t*t*(3.0f - 2.0f*t);
+            model.amplitudes[i] *= std::pow(10.0f, -m_config.deessMaxDb * t / 20.0f);
+        }
+    }
+    if (!encodeModel(model, out)) return clear(out, Status::RejectedModel);
+    m_source = source; mbe_moveMbeParms(&source, &m_sourcePrevious);
+    m_last = model; m_haveLast = true; m_erasureCount = 0;
+    out.status = Status::Voice; return out.status;
+}
+P25ToAmbeFloat::Status P25ToAmbeFloat::silenceFrame(Frame& out) {
+    clear(out, Status::Disabled);
+    if (!m_enabled) return out.status;
+    if (!m_configValid) return clear(out, Status::RejectedConfig);
+    resetSource(); m_haveLast = false; m_erasureCount = 0;
+    return silence(out, Status::Silence);
+}
+P25ToAmbeFloat::Status P25ToAmbeFloat::idleFrame(Frame& out) {
+    clear(out, Status::Disabled);
+    if (!m_enabled) return out.status;
+    if (!m_configValid) return clear(out, Status::RejectedConfig);
+    return silence(out, Status::Silence);
+}
+P25ToAmbeFloat::Status P25ToAmbeFloat::concealErasure(Frame& out) {
+    clear(out, Status::Disabled);
+    if (!m_enabled) return out.status;
+    if (!m_configValid) return clear(out, Status::RejectedConfig);
+    if (m_haveLast && m_erasureCount < 3) {
+        if (!encodeModel(m_last, out)) return clear(out, Status::RejectedModel);
+        ++m_erasureCount; out.status = Status::Concealed; return out.status;
+    }
+    resetSource(); m_haveLast = false;
+    return silence(out, Status::Muted);
+}
+
+} // namespace vocoder
