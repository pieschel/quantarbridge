+bool AmbeToP25Float::prepareModel(const mbe_parms& source, IMBE_PARAM& model, Word32* spectralLogs, LevelerMeter* meter)
+{
+    if (!validModel(source))
+        return false;
+    const double sourceF0 = source.w0 * 8000.0 / (2.0 * PI);
+    const double period = 8000.0 / sourceF0;
+    const int b0 = std::max(0, std::min(207, static_cast<int>(std::floor(2.0 * period - 39.0))));
+    model = IMBE_PARAM();
+    Word16 pitchFrame[8] = {};
+    pitchFrame[0] = static_cast<Word16>((b0 & 0xFC) << 4);
+    pitchFrame[7] = static_cast<Word16>((b0 & 3) << 1);
+    decode_frame_vector(&model, pitchFrame);
+    const int L = model.num_harms;
+    if (L < 9 || L > 56)
+        return false;
+    const double targetF0 = static_cast<double>(model.fund_freq) / 2147483648.0 * 4000.0;
+    double sourceEnergy = 0.0, mappedEnergy = 0.0;
+    double sourceV = 0.0;
+    if (meter != nullptr) *meter = LevelerMeter();
+    double energy[56] = {}, voicedEnergy[56] = {};
+    for (int l = 1; l <= source.L; ++l) {
+        sourceEnergy += static_cast<double>(source.Ml[l]) * source.Ml[l];
+        if (meter != nullptr && source.Vl[l] != 0)
+            sourceV += static_cast<double>(source.Ml[l]) * source.Ml[l];
+    }
+    if (!std::isfinite(sourceEnergy) || sourceEnergy <= 0.0)
+        return false;
+    for (int i = 0; i < L; ++i) {
+        double index = (i + 1) * targetF0 / sourceF0 - 1.0;
+        index = std::max(0.0, std::min(static_cast<double>(source.L - 1), index));
+        const int lo = static_cast<int>(std::floor(index));
+        const int hi = std::min(source.L - 1, lo + 1);
+        const double a = index - lo;
+        const double low = static_cast<double>(source.Ml[lo + 1]) * source.Ml[lo + 1];
+        const double high = static_cast<double>(source.Ml[hi + 1]) * source.Ml[hi + 1];
+        energy[i] = (1.0 - a) * low + a * high;
+        voicedEnergy[i] = (1.0 - a) * low * (source.Vl[lo + 1] != 0) +
+            a * high * (source.Vl[hi + 1] != 0);
+        mappedEnergy += energy[i];
+    }
+    const double energyScale = mappedEnergy > 0.0 ? std::sqrt(sourceEnergy / mappedEnergy) : 1.0;
+    double bandV[12] = {}, bandU[12] = {};
+    int bandVoiced[12] = {};
+    for (int i = 0; i < L; ++i) {
+        const int group = std::min(i / 3, 11);
+        bandV[group] += voicedEnergy[i];
+        bandU[group] += energy[i] - voicedEnergy[i];
+    }
+    int b1 = 0;
+    for (int group = 0; group < model.num_bands; ++group) {
+        bandVoiced[group] = bandV[group] > bandU[group];
+        b1 = (b1 << 1) | bandVoiced[group];
+    }
+    model.b_vec[1] = static_cast<Word16>(b1);
+    const double nominalBaseScale = meter != nullptr ? std::exp2(-static_cast<double>(m_encodedGain)) : 1.0;
+    if (meter != nullptr) {
+        meter->sourceVoicedFraction = sourceV / sourceEnergy;
+        meter->omega = static_cast<double>(model.fund_freq) / 2147483648.0 * PI;
+    }
+    for (int i = 0; i < L; ++i) {
+        double shapedEnergy = energy[i];
+        const double hz = (i + 1) * targetF0;
+        if (m_deessDb > 0.0f && hz > 2200.0 && energy[i] > voicedEnergy[i]) {
+            const double t = std::max(0.0, std::min(1.0, (hz - 2200.0) / 1200.0));
+            const double smooth = t * t * (3.0 - 2.0 * t);
+            const double attenuation = std::pow(10.0, -static_cast<double>(m_deessDb) * smooth / 10.0);
+            // Keep original grouping and conservation scale. Only source UV
+            // power is reduced; no global renormalization can boost V/low bands.
+            shapedEnergy = voicedEnergy[i] + (energy[i] - voicedEnergy[i]) * attenuation;
+        }
+        const double physical = std::sqrt(shapedEnergy) * energyScale * m_sourceScale / 4.0;
+        if (!std::isfinite(physical) || physical <= 0.0)
+            return false;
+        const double logValue = std::log2(physical) * 4194304.0;
+        if (logValue < std::numeric_limits<Word32>::min() || logValue > std::numeric_limits<Word32>::max())
+            return false;
+        spectralLogs[i] = static_cast<Word32>(std::llround(logValue));
+        model.v_uv_dsn[i] = static_cast<Word16>(bandVoiced[std::min(i / 3, 11)]);
+        model.l_uv += model.v_uv_dsn[i] == 0;
+        if (meter != nullptr) {
+            const double aBase = physical * nominalBaseScale;
+            if (model.v_uv_dsn[i] != 0) { meter->EV += aBase * aBase; meter->SV += aBase; }
+            else meter->EU += aBase * aBase;
+        }
+    }
+    model.ref_pitch = static_cast<Word16>(128 * b0 + 5056);
+    model.b_vec[L + 2] = 0;
+    if (meter != nullptr)
+        meter->targetVoicedFraction = meter->EV + meter->EU > 0.0 ? meter->EV / (meter->EV + meter->EU) : 0.0;
+    return true;
+}
+
+bool AmbeToP25Float::encodePreparedModel(IMBE_PARAM& model, const Word32* spectralLogs, uint8_t* output, float gain)
+{
+    Word16 frame[8] = {};
+    m_target.set_gain_adjust(gain);
+    if (!m_target.imbe_encode_model_log(&model, spectralLogs, frame))
+        return false;
+    pack(frame, output);
+    return true;
+}
+
+bool AmbeToP25Float::encodeModel(const mbe_parms& source, uint8_t* output)
+{
+    IMBE_PARAM model = {};
+    Word32 logs[56] = {};
+    LevelerMeter meter;
+    if (!prepareModel(source, model, logs, m_levelerConfig.enabled ? &meter : nullptr))
+        return false;
+    if (!m_levelerConfig.enabled)
+        return encodePreparedModel(model, logs, output, m_encodedGain);
+    // This entry is used for lastGood concealment and private model probes.
+    // It has no accepted-current-source authority to learn a station level.
+    LevelerContext context;
+    context.freeze = true;
+    LevelerState next = m_levelerState;
+    proposeLeveler(next, meter, context);
+    if (!encodePreparedModel(model, logs, output, effectiveLevelerGain(next)))
+        return false;
+    finishLeveler(next, meter, context);
+    m_levelerState = next;
+    return true;
+}
+
+AmbeToP25Float::Result AmbeToP25Float::erasure(uint8_t* output, unsigned errors)
+{
+    if (m_erasures < 255U)
+        ++m_erasures;
+    if (m_haveLast && m_erasures <= 3U && encodeModel(m_lastGood, output))
+        return {Status::Concealed, errors, m_erasures, false};
+    resetSource();
+    emitNull(output);
+    if (m_levelerConfig.enabled) m_levelerState.reason = LevelerReason::Muted;
+    return {Status::Muted, errors, m_erasures, false};
+}
+
+AmbeToP25Float::Result AmbeToP25Float::convert(const uint8_t* input, uint8_t* output, bool encrypted)
+{
+    assert(output != nullptr);
+    if (encrypted) {
+        resetSource();
+        m_erasures = 0;
+        emitNull(output);
+        if (m_levelerConfig.enabled) m_levelerState.reason = LevelerReason::Encrypted;
+        return {Status::EncryptedMuted, 0, 0, false};
+    }
+    if (input == nullptr)
+        return erasure(output, 0);
+    char frame[4][24] = {}, bits[49] = {};
+    for (int i = 0; i < 36; ++i) {
+        frame[RW[i]][RX[i]] = (input[(2 * i) / 8] >> (7 - (2 * i) % 8)) & 1;
+        frame[RY[i]][RZ[i]] = (input[(2 * i + 1) / 8] >> (7 - (2 * i + 1) % 8)) & 1;
+    }
+    int errors = mbe_eccAmbe3600x2450C0(frame);
+    mbe_demodulateAmbe3600x2450Data(frame);
+    errors += mbe_eccAmbe3600x2450Data(frame, bits);
+    if (errors > 3)
+        return erasure(output, static_cast<unsigned>(errors));
+    int b0 = 0;
+    for (int index : {0,1,2,3,37,38,39})
+        b0 = (b0 << 1) | bits[index];
+    if (b0 == 126 || b0 == 127) {
+        resetSource();
+        m_erasures = 0;
+        emitNull(output);
+        if (m_levelerConfig.enabled) m_levelerState.reason = LevelerReason::Tone;
+        return {Status::ToneMuted, static_cast<unsigned>(errors), 0, false};
+    }
+    if (b0 >= 120 && b0 <= 123)
+        return erasure(output, static_cast<unsigned>(errors));
+    // The source decoder uses the legacy PRBA bit-field convention. Adapt
+    // only its local model input; retain original bits for FEC and guards.
+    char modelBits[49];
+    std::memcpy(modelBits, bits, sizeof(modelBits));
+    modelBits[40] = bits[43];
+    modelBits[41] = bits[40];
+    modelBits[42] = bits[41];
+    modelBits[43] = bits[42];
+    mbe_parms trial = m_current, previous = m_previous;
+    int b1 = 0;
+    for (int index : {4,5,6,7,35})
+        b1 = (b1 << 1) | bits[index];
+    // For the proven native codebook rows18..31 no band carries ordinary
+    // code1 and at least one carries fixed-frequency code2. Original type/FEC
+    // guards above retain priority. The exported model remains binary V/U;
+    // only its raw spectral grid/history is corrected here.
+    const bool nativeExtraGrid = b0 < 120 && b1 >= 18;
+    const bool nativeGridHistory = b0 < 120 && (nativeExtraGrid || previous.L == 56);
+    const int decodeStatus = nativeGridHistory ?
+        decodeSourceGridParms(modelBits, &trial, &previous, nativeExtraGrid) :
+        mbe_decodeAmbe2450Parms(modelBits, &trial, &previous);
+    if (decodeStatus != 0 || !validModel(trial))
+        return erasure(output, static_cast<unsigned>(errors));
+    if (!m_levelerConfig.enabled) {
+        if (!encodeModel(trial, output))
+            return erasure(output, static_cast<unsigned>(errors));
+    } else {
+        IMBE_PARAM model = {};
+        Word32 logs[56] = {};
+        LevelerMeter meter;
+        if (!prepareModel(trial, model, logs, &meter))
+            return erasure(output, static_cast<unsigned>(errors));
+        LevelerContext context;
+        context.ordinary = b0 < 120 && b1 < 18;
+        context.extra = nativeExtraGrid;
+        context.codedSilence = b0 == 124 || b0 == 125;
+        context.fec = static_cast<unsigned>(errors);
+        context.freeze = errors != 0;
+        LevelerState next = m_levelerState;
+        proposeLeveler(next, meter, context);
+        if (!encodePreparedModel(model, logs, output, effectiveLevelerGain(next)))
+            return erasure(output, static_cast<unsigned>(errors));
+        finishLeveler(next, meter, context);
+        m_levelerState = next;
+    }
+    m_current = trial;
+    mbe_moveMbeParms(&m_current, &m_previous);
+    m_lastGood = trial;
+    m_haveLast = true;
+    m_erasures = 0;
+    return {b0 == 124 || b0 == 125 ? Status::CodedSilence : Status::Voice,
+        static_cast<unsigned>(errors), 0, true};
+}
