new file mode 100644
index 00000000..48dd0cd3
--- /dev/null
+++ b/src/vocoder/ReverseLevelerControl.inc
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// ONE per-call scalar controller, Root v4 independent rendering envelopes.
+// table changes, shared registry or source-predictor storage is used here.
+namespace {
+constexpr double LEVELER_REF_EV = 504188.0;
+constexpr double LEVELER_REF_DBFS = -29.5;
+constexpr double LEVELER_VOICE_FLOOR = 2007.2085810702672;
+constexpr double LEVELER_DB_PER_LOG2 = 6.020599913279624;
+constexpr double LEVELER_NOISE_V = 2.309693;
+constexpr double LEVELER_NOISE_U = 7.4231003;
+constexpr double LEVELER_ALPHA_CUT = 0.22119921692859512; // 1-exp(-20/80)
+constexpr double LEVELER_ALPHA_UP = 0.019801326693244747; // 1-exp(-20/1000)
+constexpr double LEVELER_ALPHA_ESTIMATE = 0.048770575499285984; // 400ms
+constexpr double LEVELER_ALPHA_NOISE_DOWN = 0.09516258196404048; // 200ms
+constexpr double LEVELER_ALPHA_NOISE_UP = 0.001998001332666921; // 10s
+double levelerClamp(double v, double lo, double hi) { return std::max(lo, std::min(hi, v)); }
+unsigned levelerAge(unsigned v) { return v < 3600000U ? v + 20U : 3600000U; }
+}
+
+bool AmbeToP25Float::setLevelerConfig(const LevelerConfig& config)
+{
+    if (!std::isfinite(config.targetDbfs) || config.targetDbfs < -45.0f || config.targetDbfs > -20.0f ||
+        !std::isfinite(config.maxBoostDb) || config.maxBoostDb < 0.0f || config.maxBoostDb > 12.0f ||
+        !std::isfinite(config.maxCutDb) || config.maxCutDb < 0.0f || config.maxCutDb > 18.0f)
+        return false;
+    m_levelerConfig = config;
+    resetLeveler();
+    return true;
+}
+
+void AmbeToP25Float::resetLeveler()
+{
+    m_levelerState = LevelerState();
+    ++m_levelerResetGeneration;
+    m_levelerState.reason = m_levelerConfig.enabled ? LevelerReason::Bootstrap : LevelerReason::Disabled;
+    m_levelerState.boostCapDb = std::min(6.0, static_cast<double>(m_levelerConfig.maxBoostDb));
+    m_levelerState.noiseAllowedGainDb = m_levelerState.boostCapDb;
+    m_levelerState.peakAllowedGainDb = m_levelerConfig.maxBoostDb;
+}
+
+AmbeToP25Float::LevelerDiagnostics AmbeToP25Float::getLevelerDiagnostics() const
+{
+    const LevelerState& x = m_levelerState;
+    LevelerDiagnostics d = {};
+    d.enabled = m_levelerConfig.enabled;
+    d.estimateReady = x.estimateReady;
+    d.noiseTrusted = x.noiseObservations >= 4U;
+    d.learnedThisFrame = x.learned;
+    d.noiseObservedThisFrame = x.noiseObserved;
+    d.peakLimited = x.peakLimited;
+    d.noiseLimited = x.noiseLimited;
+    d.ceilingUnsatisfied = x.ceilingUnsatisfied;
+    d.fadeActive = x.fading;
+    d.feedbackSaturated = x.saturated;
+    d.predictedSpeechEligible = x.predictedEligible;
+    d.framesEncoded = x.frames;
+    d.confirmedVoiceFrames = x.confirmedVoice;
+    d.learnedWindows = x.learnedWindows;
+    d.resetGeneration = m_levelerResetGeneration;
+    d.consecutiveVoiceFrames = x.voiceStreak;
+    d.noiseObservations = x.noiseObservations;
+    d.nonVoiceMs = x.nonVoiceMs;
+    d.levelGainDb = x.levelGainDb;
+    d.appliedGainDb = x.appliedGainDb;
+    d.estimatedEVBase = x.estimateEV;
+    d.estimatedLevelDbfs = x.estimateReady ?
+        LEVELER_REF_DBFS + 10.0 * std::log10(std::max(x.estimateEV, 1.0e-12) / LEVELER_REF_EV) : -120.0;
+    d.noiseFloorDbfs = x.noiseFloorDbfs;
+    d.boostCapDb = x.boostCapDb;
+    d.predictedPeakBound = x.peakBound;
+    d.peakCapDb = x.peakCapDb;
+    d.sourceVoicedFraction = x.sourceVoicedFraction;
+    d.targetPredVoicedFraction = x.targetPredVoicedFraction;
+    d.targetWireVoicedFraction = x.targetWireVoicedFraction;
+    d.feedbackEVBase = x.feedbackEVBase;
+    d.noisePowerBase = x.noisePowerBase;
+    d.activityGainDb = x.activityGainDb;
+    d.noiseAllowedGainDb = x.noiseAllowedGainDb;
+    d.peakAllowedGainDb = x.peakAllowedGainDb;
+    d.activityRecovering = x.activityRecovering;
+    d.normalControllerTick = x.normalControllerTick;
+    d.reason = x.reason;
+    return d;
+}
+
+double AmbeToP25Float::levelerBoostCap(const LevelerState& x) const
+{
+    double cap = x.confirmedVoice >= 50U && x.noiseObservations >= 4U ? 12.0 : 6.0;
+    if (x.noiseObservations >= 4U) {
+        const double noiseRms = std::max(1.0, x.noiseFloorRms);
+        const double noiseCap = levelerClamp(20.0 * std::log10(184.2680054383736 / noiseRms), 0.0, 12.0);
+        cap = std::min(cap, noiseCap);
+    }
+    return std::min(cap, static_cast<double>(m_levelerConfig.maxBoostDb));
+}
+
+void AmbeToP25Float::proposeLeveler(LevelerState& x, const LevelerMeter& meter,
+    const LevelerContext& context) const
+{
+    x.learned = x.noiseObserved = x.peakLimited = x.noiseLimited = false;
+    x.ceilingUnsatisfied = x.saturated = x.normalControllerTick = false;
+    x.sourceVoicedFraction = meter.sourceVoicedFraction;
+    x.targetPredVoicedFraction = meter.targetVoicedFraction;
+    x.targetWireVoicedFraction = 0.0;
+    x.feedbackEVBase = x.noisePowerBase = 0.0;
+    x.boostCapDb = levelerBoostCap(x);
+    const bool frozen = context.freeze || context.fec != 0U;
+    x.predictedEligible = !frozen && context.ordinary &&
+        meter.sourceVoicedFraction >= 0.5 && meter.targetVoicedFraction >= 0.5 &&
+        meter.EV >= LEVELER_VOICE_FLOOR;
+
+    // The learned station correction is NOT an activity envelope. Once the
+    // initial estimate exists, valid U/CN slots clock it toward that HELD
+    // estimate without learning a single new speech observation from noise.
+    if (!frozen && x.estimateReady) {
+        x.normalControllerTick = true;
+        const double targetEV = LEVELER_REF_EV *
+            std::pow(10.0, (static_cast<double>(m_levelerConfig.targetDbfs) - LEVELER_REF_DBFS) / 10.0);
+        const double desired = levelerClamp(10.0 * std::log10(targetEV / std::max(x.estimateEV, 1.0e-12)),
+            -static_cast<double>(m_levelerConfig.maxCutDb), static_cast<double>(m_levelerConfig.maxBoostDb));
+        const double error = desired - x.levelGainDb;
+        if (std::fabs(error) > 1.0)
+            x.levelGainDb += (error < 0.0 ? LEVELER_ALPHA_CUT : LEVELER_ALPHA_UP) * error;
+    }
+
+    // Noise/confidence is a rendering constraint, independent of the station
+    // estimate and the CN/activity override. In particular 6->12 never jumps.
+    if (x.boostCapDb < x.noiseAllowedGainDb)
+        x.noiseAllowedGainDb = x.boostCapDb;
+    else if (!frozen)
+        x.noiseAllowedGainDb += LEVELER_ALPHA_UP * (x.boostCapDb - x.noiseAllowedGainDb);
+
+    if (x.predictedEligible) {
+        x.nonVoiceMs = 0U;
+        x.fading = false;
+        x.fadeMs = 0.0;
+        x.reason = x.estimateReady ? LevelerReason::Speech : LevelerReason::Bootstrap;
+        if (!x.estimateReady) {
+            // No positive station correction exists before four qualified
+            // bootstrap frames. Peak protection is already available below.
+            x.activityGainDb = x.levelGainDb;
+        } else if (x.activityGainDb >= x.levelGainDb) {
+            x.activityGainDb = x.levelGainDb;
+            x.activityRecovering = false;
+        } else if (x.activityRecovering) {
+            // This80ms reapplication clock is separate from normal1s gain
+            // convergence and from the independent slow safety envelopes.
+            x.activityGainDb += LEVELER_ALPHA_CUT * (x.levelGainDb - x.activityGainDb);
+            const float activityCode = static_cast<float>(static_cast<double>(m_encodedGain) - x.activityGainDb / LEVELER_DB_PER_LOG2);
+            const float stationCode = static_cast<float>(static_cast<double>(m_encodedGain) - x.levelGainDb / LEVELER_DB_PER_LOG2);
+            if (activityCode == stationCode) {
+                x.activityGainDb = x.levelGainDb;
+                x.activityRecovering = false;
+            }
+        } else {
+            x.activityGainDb = x.levelGainDb;
+        }
+    } else {
+        // EVERY non-speech frame holds at most the prior ACTUAL render. A
+        // peak/noise constraint that fell during U may not later release
+        // underneath a stale higher activity snapshot and lift that noise.
+        x.activityGainDb = std::min(x.activityGainDb, m_levelerState.appliedGainDb);
+        x.voiceStreak = x.voiceCount = x.voicePosition = 0U;
+        if (frozen) {
+            x.reason = context.fec != 0U ? LevelerReason::Fec : LevelerReason::Concealment;
+        } else {
+            x.nonVoiceMs = levelerAge(x.nonVoiceMs);
+            x.reason = context.extra ? LevelerReason::Extra : context.codedSilence ?
+                LevelerReason::CodedSilence : LevelerReason::Unvoiced;
+            const double proxyEV = meter.EV + LEVELER_NOISE_U / LEVELER_NOISE_V * meter.omega * meter.EU;
+            if (proxyEV < LEVELER_VOICE_FLOOR && !context.extra && !context.codedSilence)
+                x.reason = LevelerReason::LowEnergy;
+            if (x.nonVoiceMs >= 300U || x.fading) {
+                if (!x.fading) {
+                    x.fading = true;
+                    x.fadeMs = 0.0;
+                    x.fadeAppliedStart = std::max(0.0, x.activityGainDb);
+                } else {
+                    x.fadeMs = std::min(300.0, x.fadeMs + 20.0);
+                }
+                const double remain = std::max(0.0, 1.0 - x.fadeMs / 300.0);
+                if (x.activityGainDb > 0.0)
+                    x.activityGainDb = std::min(x.activityGainDb, x.fadeAppliedStart * remain);
+            }
+        }
+        if (context.codedSilence)
+            x.activityGainDb = std::min(x.activityGainDb, 0.0);
+        const float activityCode = static_cast<float>(static_cast<double>(m_encodedGain) - x.activityGainDb / LEVELER_DB_PER_LOG2);
+        const float stationCode = static_cast<float>(static_cast<double>(m_encodedGain) - x.levelGainDb / LEVELER_DB_PER_LOG2);
+        if (x.activityGainDb < x.levelGainDb && activityCode != stationCode)
+            x.activityRecovering = true;
+    }
+
+    double maxSV = meter.SV, maxWU = meter.omega * meter.EU;
+    for (unsigned i = 0; i < x.peakCount; ++i) {
+        maxSV = std::max(maxSV, x.peakSV[i]);
+        maxWU = std::max(maxWU, x.peakWU[i]);
+    }
+    x.peakBound = 3.0 * maxSV + 24.0 * std::sqrt(std::max(0.0, maxWU)) + 1024.0;
+    x.peakCapDb = 20.0 * std::log10(24000.0 / x.peakBound);
+    const double emergencyFloor = std::max(-42.0,
+        (static_cast<double>(m_encodedGain) - 8.0) * LEVELER_DB_PER_LOG2);
+    const double peakGoal = std::max(emergencyFloor, x.peakCapDb);
+    if (peakGoal < x.peakAllowedGainDb)
+        x.peakAllowedGainDb = peakGoal;
+    else if (!frozen)
+        x.peakAllowedGainDb += LEVELER_ALPHA_UP * (peakGoal - x.peakAllowedGainDb);
+    x.noiseLimited = x.activityGainDb > x.noiseAllowedGainDb + 1.0e-9;
+    x.peakLimited = x.activityGainDb > x.peakAllowedGainDb + 1.0e-9;
+    x.appliedGainDb = std::min(x.activityGainDb, std::min(x.noiseAllowedGainDb, x.peakAllowedGainDb));
+    x.appliedGainDb = std::max(x.appliedGainDb, emergencyFloor);
+    x.ceilingUnsatisfied = x.appliedGainDb > x.peakCapDb + 1.0e-6;
+}
+
+float AmbeToP25Float::effectiveLevelerGain(LevelerState& x) const
+{
+    const float effective = std::min(8.0f, static_cast<float>(
+        static_cast<double>(m_encodedGain) - x.appliedGainDb / LEVELER_DB_PER_LOG2));
+    // Feedback must remove the actual float gain given to the quantizer,
+    // rather than an ever-so-slightly different desired scalar.
+    x.appliedGainDb = (static_cast<double>(m_encodedGain) - effective) * LEVELER_DB_PER_LOG2;
+    return effective;
+}
+
+void AmbeToP25Float::finishLeveler(LevelerState& x, const LevelerMeter& meter,
+    const LevelerContext& context)
+{
+    ++x.frames;
+    const IMBE_PARAM* wire = m_target.param();
+    double EV = 0.0, EU = 0.0, SV = 0.0;
+    bool saturated = false;
+    for (int i = 0; i < wire->num_harms; ++i) {
+        const int sa = wire->sa[i];
+        saturated = saturated || sa >= 32767 || sa < 0;
+        const double a = std::max(0, sa) / 4.0;
+        if (wire->v_uv_dsn[i] != 0) { EV += a * a; SV += a; }
+        else EU += a * a;
+    }
+    const double undo = std::pow(10.0, -x.appliedGainDb / 10.0);
+    EV *= undo; EU *= undo; SV *= std::sqrt(undo);
+    const double omega = static_cast<double>(wire->fund_freq) / 2147483648.0 * PI;
+    x.saturated = saturated;
+    x.feedbackEVBase = EV;
+    x.targetWireVoicedFraction = EV + EU > 0.0 ? EV / (EV + EU) : 0.0;
+    x.noisePowerBase = LEVELER_NOISE_V * EV + LEVELER_NOISE_U * omega * EU;
+
+    // A saturated Word16 amplitude is not valid feedback. Retain a conservative
+    // requested-model guard record for that unsupported observation only.
+    x.peakSV[x.peakPosition] = saturated ? meter.SV : SV;
+    x.peakWU[x.peakPosition] = saturated ? meter.omega * meter.EU : omega * EU;
+    x.peakPosition = (x.peakPosition + 1U) % 3U;
+    x.peakCount = std::min(3U, x.peakCount + 1U);
+    if (context.freeze || context.fec != 0U)
+        return;
+
+    const bool speech = x.predictedEligible && !saturated &&
+        x.targetWireVoicedFraction >= 0.5 && EV > LEVELER_VOICE_FLOOR;
+    if (speech) {
+        x.nonVoiceMs = 0U;
+        x.fading = false;
+        x.voicePower[x.voicePosition] = EV;
+        x.voicePosition = (x.voicePosition + 1U) % 4U;
+        x.voiceCount = std::min(4U, x.voiceCount + 1U);
+        if (x.voiceStreak < 1000000U) ++x.voiceStreak;
+        ++x.confirmedVoice;
+        if (x.voiceCount == 4U && x.voiceStreak >= 4U) {
+            double power = 0.0;
+            for (double v : x.voicePower) power += v * 0.25;
+            if (!x.estimateReady) { x.estimateEV = power; x.estimateReady = true; }
+            else x.estimateEV += LEVELER_ALPHA_ESTIMATE * (power - x.estimateEV);
+            x.learned = true;
+            ++x.learnedWindows;
+        }
+        x.reason = x.estimateReady ? LevelerReason::Speech : LevelerReason::Bootstrap;
+    } else {
+        // The current requested model can pass the pre-encode gate while
+        // quantization/saturation vetoes its feedback. Do not learn it.
+        x.nonVoiceMs = levelerAge(m_levelerState.nonVoiceMs);
+        x.voiceStreak = x.voiceCount = x.voicePosition = 0U;
+        if (saturated) x.reason = LevelerReason::SaturatedFeedback;
+        const bool ordinaryQuiet = context.ordinary && meter.sourceVoicedFraction < 0.1 &&
+            x.targetWireVoicedFraction < 0.1;
+        if (!saturated && !context.extra &&
+            (context.codedSilence || (ordinaryQuiet && x.nonVoiceMs >= 300U))) {
+            const double observedRms = std::sqrt(std::max(x.noisePowerBase, 0.0));
+            if (x.noiseObservations == 0U) x.noiseFloorRms = observedRms;
+            else if (x.noiseObservations < 4U) x.noiseFloorRms = std::min(x.noiseFloorRms, observedRms);
+            else {
+                x.noiseFloorRms += (observedRms < x.noiseFloorRms ?
+                    LEVELER_ALPHA_NOISE_DOWN : LEVELER_ALPHA_NOISE_UP) * (observedRms - x.noiseFloorRms);
+            }
+            x.noiseFloorDbfs = 20.0 * std::log10(std::max(x.noiseFloorRms, 1.0e-12) / 32768.0);
+            if (x.noiseObservations < 1000000U) ++x.noiseObservations;
+            x.noiseObserved = true;
+        }
+    }
+    x.boostCapDb = levelerBoostCap(x);
+}
