+
+bool imbe_vocoder::imbe_track_encoded_model(const Word16* frame_vector)
+{
+    if (frame_vector == nullptr)
+        return false;
+    const unsigned widths[8] = {12,12,12,12,11,11,11,7};
+    Word16 frame[8];
+    for (unsigned i = 0; i < 8; ++i) {
+        if (frame_vector[i] < 0 || static_cast<unsigned>(frame_vector[i]) >= (1U << widths[i]))
+            return false;
+        frame[i] = frame_vector[i];
+    }
+    const int b0 = ((frame[0] >> 4) & 0xFC) | ((frame[7] >> 1) & 3);
+    if (b0 > 207)
+        return false;
+    decode_frame_vector(&my_imbe_param, frame);
+    v_uv_decode(&my_imbe_param);
+    sa_decode(&my_imbe_param);
+    num_harms_prev2 = num_harms_prev1;
+    ::memcpy(sa_prev2, sa_prev1, sizeof(sa_prev2));
+    return true;
+}
+
+bool imbe_vocoder::imbe_encode_model_log(IMBE_PARAM* model, const Word32* spectralLogs, Word16* frame_vector)
+{
+    if (model == nullptr || spectralLogs == nullptr || frame_vector == nullptr)
+        return false;
+    const int b0 = model->b_vec[0];
+    if (b0 < 0 || b0 > 207 || model->num_harms < 9 || model->num_harms > 56)
+        return false;
+    IMBE_PARAM pitch = {};
+    Word16 check[8] = {};
+    check[0] = static_cast<Word16>((b0 & 0xFC) << 4);
+    check[7] = static_cast<Word16>((b0 & 3) << 1);
+    decode_frame_vector(&pitch, check);
+    if (model->num_harms != pitch.num_harms || model->num_bands != pitch.num_bands ||
+        model->b_vec[1] < 0 || static_cast<unsigned>(model->b_vec[1]) >= (1U << model->num_bands))
+        return false;
+    // Quantize normally, then evaluate legal adjacent spectral indices against
+    // the actual decoder reconstruction from this SAME pre-frame history.
+    // Pitch, voicing, bit allocation and the requested gain are unchanged.
+    const imbe_vocoder beforeFrame = *this;
+    IMBE_PARAM working = *model;
+    sa_encode_log(&working, spectralLogs);
+    const int L = working.num_harms;
+    const auto distortion = [&](IMBE_PARAM trial) -> double {
+        Word16 encoded[8] = {};
+        encode_frame_vector(&trial, encoded);
+        imbe_vocoder decoded = beforeFrame;
+        if (!decoded.imbe_track_encoded_model(encoded))
+            return 1.0e100;
+        double sum = 0.0;
+        for (int i = 0; i < L; ++i) {
+            const double desired = static_cast<double>(spectralLogs[i]) / 4194304.0 - d_gain_adjust;
+            const double actual = static_cast<double>(decoded.sa_prev1[i + 1]) / 4194304.0;
+            const double error = actual - desired;
+            sum += error * error;
+        }
+        return sum;
+    };
+    double best = distortion(working);
+    // A fixed two-pass coordinate neighbourhood bounds CPU cost; strict
+    // improvement keeps ties and the ordinary quantizer result deterministic.
+    for (int pass = 0; pass < 2; ++pass) {
+        bool improved = false;
+        for (int index = 2; index <= L + 1; ++index) {
+            const int width = index == 2 ? 6 : working.bit_alloc[index - 3];
+            if (width <= 0 || width > 15)
+                continue;
+            const int maximum = (1 << width) - 1;
+            const Word16 old = working.b_vec[index];
+            Word16 selected = old;
+            for (int step = -1; step <= 1; step += 2) {
+                const int value = old + step;
+                if (value < 0 || value > maximum)
+                    continue;
+                IMBE_PARAM trial = working;
+                trial.b_vec[index] = static_cast<Word16>(value);
+                const double score = distortion(trial);
+                if (score + 1.0e-12 < best) {
+                    best = score;
+                    selected = static_cast<Word16>(value);
+                }
+            }
+            if (selected != old) {
+                working.b_vec[index] = selected;
+                improved = true;
+            }
+        }
+        if (!improved)
+            break;
+    }
+    encode_frame_vector(&working, frame_vector);
+    // Commit only the exact selected wire frame to BOTH predictor histories.
+    return imbe_track_encoded_model(frame_vector);
+}
