+// SPDX-License-Identifier: GPL-2.0-only
+#if !defined(__AMBE_TO_P25_FLOAT_H__)
+#define __AMBE_TO_P25_FLOAT_H__
+
+#include "common/Defines.h"
+#include "vocoder/mbe.h"
+#include "vocoder/imbe/imbe_vocoder.h"
+#include <cstdint>
+
+namespace vocoder {
+
+/** Clear AMBE+2 model -> IMBE model requantizer. One instance belongs to one call.
+ * No PCM synthesis/analysis is performed. Source Ml is physical linear amplitude;
+ * sourceScaleQ14_2=4 converts to the fixed codec's historical Q14.2 reference.
+ * The quantizer receives log2(physical amplitude) as signed Q10.22 directly.
+ */
+class HOST_SW_API AmbeToP25Float {
+public:
+    enum class Status { Voice, CodedSilence, Concealed, Muted, ToneMuted, EncryptedMuted };
+    struct Result {
+        Status status;
+        unsigned fecCorrections;
+        unsigned consecutiveErasures;
+        bool sourceAccepted;
+    };
+
+    // Optional per-call station level control. Result and the original object
+    // prefix remain unchanged; all header-dependent owners must be rebuilt.
+    struct LevelerConfig {
+        bool enabled = false;
+        float targetDbfs = -29.5f;
+        float maxBoostDb = 12.0f;
+        float maxCutDb = 18.0f;
+    };
+    enum class LevelerReason : unsigned {
+        Disabled, Bootstrap, Speech, Unvoiced, Extra, Fec, CodedSilence,
+        Concealment, Muted, Tone, Encrypted, LowEnergy, SaturatedFeedback
+    };
+    struct LevelerDiagnostics {
+        bool enabled, estimateReady, noiseTrusted, learnedThisFrame;
+        bool noiseObservedThisFrame, peakLimited, noiseLimited;
+        bool ceilingUnsatisfied, fadeActive, feedbackSaturated, predictedSpeechEligible;
+        uint64_t framesEncoded, confirmedVoiceFrames, learnedWindows, resetGeneration;
+        unsigned consecutiveVoiceFrames, noiseObservations, nonVoiceMs;
+        double levelGainDb, appliedGainDb, estimatedEVBase, estimatedLevelDbfs;
+        double noiseFloorDbfs, boostCapDb, predictedPeakBound, peakCapDb;
+        double sourceVoicedFraction, targetPredVoicedFraction, targetWireVoicedFraction;
+        double feedbackEVBase, noisePowerBase;
+        double activityGainDb, noiseAllowedGainDb, peakAllowedGainDb;
+        bool activityRecovering, normalControllerTick;
+        LevelerReason reason;
+    };
+
+    AmbeToP25Float();
+    AmbeToP25Float(const AmbeToP25Float&) = delete;
+    AmbeToP25Float& operator=(const AmbeToP25Float&) = delete;
+    void reset();
+    bool setLevel(float sourceScaleQ14_2, float encodedLog2Gain);
+    bool setDeessDb(float maximumDb);
+    bool setLevelerConfig(const LevelerConfig& config);
+    LevelerDiagnostics getLevelerDiagnostics() const;
+    Result convert(const uint8_t ambe[9], uint8_t imbe[11], bool encrypted = false);
+
+private:
+    mbe_parms m_current, m_previous, m_unusedEnhanced, m_lastGood;
+    imbe_vocoder m_target;
+    bool m_haveLast;
+    unsigned m_erasures;
+    float m_sourceScale, m_encodedGain, m_deessDb;
+
+    // Appended controller state only: no storage borrowed from MBE predictors.
+    struct LevelerMeter {
+        double sourceVoicedFraction = 0, targetVoicedFraction = 0;
+        double EV = 0, EU = 0, SV = 0, omega = 0;
+    };
+    struct LevelerContext {
+        bool ordinary = false, codedSilence = false, extra = false;
+        bool freeze = false;
+        unsigned fec = 0;
+    };
+    struct LevelerState {
+        double levelGainDb = 0, appliedGainDb = 0, estimateEV = 0;
+        double activityGainDb = 0, noiseAllowedGainDb = 6, peakAllowedGainDb = 12;
+        bool activityRecovering = false, normalControllerTick = false;
+        double voicePower[4] = {}, peakSV[3] = {}, peakWU[3] = {};
+        unsigned voicePosition = 0, voiceCount = 0, voiceStreak = 0;
+        unsigned peakPosition = 0, peakCount = 0, nonVoiceMs = 0;
+        uint64_t confirmedVoice = 0, learnedWindows = 0, frames = 0;
+        bool estimateReady = false;
+        double noiseFloorDbfs = -90.30899869919436;
+        double noiseFloorRms = 0.0;
+        unsigned noiseObservations = 0;
+        bool fading = false;
+        double fadeMs = 0, fadeLevelStart = 0, fadeAppliedStart = 0;
+        bool learned = false, noiseObserved = false, peakLimited = false;
+        bool noiseLimited = false, ceilingUnsatisfied = false, saturated = false;
+        bool predictedEligible = false;
+        double boostCapDb = 6, peakBound = 1024, peakCapDb = 27.399;
+        double sourceVoicedFraction = 0, targetPredVoicedFraction = 0;
+        double targetWireVoicedFraction = 0, feedbackEVBase = 0, noisePowerBase = 0;
+        LevelerReason reason = LevelerReason::Disabled;
+    };
+    LevelerConfig m_levelerConfig;
+    LevelerState m_levelerState;
+    uint64_t m_levelerResetGeneration;
+
+    void resetSource();
+    void emitNull(uint8_t imbe[11]);
+    bool encodeModel(const mbe_parms& source, uint8_t imbe[11]);
+    bool prepareModel(const mbe_parms& source, IMBE_PARAM& model, Word32* logs, LevelerMeter* meter);
+    bool encodePreparedModel(IMBE_PARAM& model, const Word32* logs, uint8_t* output, float gain);
+    void resetLeveler();
+    double levelerBoostCap(const LevelerState& state) const;
+    void proposeLeveler(LevelerState& state, const LevelerMeter& meter, const LevelerContext& context) const;
+    void finishLeveler(LevelerState& state, const LevelerMeter& meter, const LevelerContext& context);
+    float effectiveLevelerGain(LevelerState& state) const;
+    Result erasure(uint8_t imbe[11], unsigned errors);
+};
+}
+#endif
