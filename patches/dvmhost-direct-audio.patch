diff --git a/src/bridge/DirectImbeAmbe.cpp b/src/bridge/DirectImbeAmbe.cpp
new file mode 100644
index 00000000..c6e36e65
--- /dev/null
+++ b/src/bridge/DirectImbeAmbe.cpp
@@ -0,0 +1,65 @@
+// Isolated implementation: shares the existing AMBE parameter quantizer.
+#include "vocoder/MBEEncoder.cpp"
+#include "DirectImbeAmbe.h"
+#include <memory>
+#include <cmath>
+#include <stdexcept>
+namespace quantar_direct {
+namespace {
+bool active = false;
+float adjustment = 1.58f;
+struct State {
+    imbe_vocoder decoder;
+    mbe_parms current, previous, enhanced;
+    State() { mbe_initMbeParms(&current, &previous, &enhanced); }
+};
+thread_local std::unique_ptr<State> state;
+void silence(uint8_t* word) {
+    static const uint8_t quiet[9] = {0xB9,0xE8,0x81,0x52,0x61,0x73,0x00,0x2A,0x6B};
+    std::memcpy(word, quiet, sizeof(quiet));
+}
+}
+void configure(bool on, float value) {
+    if (!std::isfinite(value) || value < 0.0f || value > 4.0f)
+        throw std::invalid_argument("directImbeGainAdjust must be finite and between 0 and 4");
+    active = on; adjustment = value;
+}
+bool enabled() { return active; }
+float gain() { return adjustment; }
+void reset() { state.reset(new State()); }
+bool convert(const uint8_t* imbe, uint8_t* ambe) {
+    if (!imbe || !ambe) return false;
+    int16_t vector[8] = {}, discarded[160];
+    unsigned bit = 0;
+    for (int v = 0; v < 8; ++v) {
+        const int width = v < 4 ? 12 : (v < 7 ? 11 : 7);
+        for (int b = 0; b < width; ++b, ++bit)
+            vector[v] = (vector[v] << 1) | ((imbe[bit / 8] >> (7 - bit % 8)) & 1);
+    }
+    // Validate pitch before the legacy decoder can reuse stale parameters.
+    const int pitchCode = ((vector[0] >> 4) & 0xFC) | ((vector[7] >> 1) & 3);
+    if (pitchCode > 207) { silence(ambe); return false; }
+    if (!state) reset();
+    state->decoder.imbe_decode(vector, discarded);
+    IMBE_PARAM parameters = *state->decoder.param();
+    if (parameters.num_harms < 9 || parameters.num_harms > 56) { silence(ambe); return false; }
+    parameters.ref_pitch = std::max(159 * 32, std::min(985 * 32, (2 * pitchCode + 79) * 64));
+    // Prove the lookup can find this harmonic count before calling the legacy quantizer.
+    const int count = sizeof(b0_lookup) / sizeof(b0_lookup[0]);
+    int index = (parameters.ref_pitch >> 5) - 159;
+    bool found = false;
+    for (int steps = 0; steps < count && index >= 0 && index < count; ++steps) {
+        const int harmonics = static_cast<int>(AmbeLtable[b0_lookup[index]]);
+        if (harmonics == parameters.num_harms) { found = true; break; }
+        index += harmonics < parameters.num_harms ? 1 : -1;
+    }
+    if (!found) { silence(ambe); return false; }
+    int quantized[9] = {};
+    encodeAMBE(&parameters, quantized, &state->current, &state->previous, adjustment);
+    uint8_t bits[49] = {}, raw[9] = {};
+    encode49bit(bits, quantized);
+    for (int i = 0; i < 49; ++i) raw[i / 8] |= bits[i] << (7 - i % 8);
+    encodeDmrAMBE(raw, ambe);
+    return true;
+}
+}
