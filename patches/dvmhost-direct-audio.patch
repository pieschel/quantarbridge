index 00000000..776cfd8d
--- /dev/null
+++ b/src/bridge/DirectAmbeImbe.cpp
@@ -0,0 +1,83 @@
+#include "DirectAmbeImbe.h"
+#include "vocoder/imbe/imbe.h"
+#include "vocoder/imbe/ch_encode.h"
+#include "vocoder/imbe/ch_decode.h"
+#include "vocoder/imbe/imbe_vocoder.h"
+#include "vocoder/MBEDecoder.h"
+#include <memory>
+#include <cmath>
+#include <algorithm>
+#include <stdexcept>
+#include <cstring>
+namespace quantar_reverse {
+namespace {
+bool active=false;
+float spectralScale=4.0f, gainAdjust=1.0f;
+struct State {
+ vocoder::MBEDecoder unpack;
+ mbe_parms cur,prev,enh;
+ imbe_vocoder encoder;
+ IMBE_PARAM last{};
+ bool hasLast=false;
+ unsigned losses=0;
+ State():unpack(vocoder::DECODE_DMR_AMBE){mbe_initMbeParms(&cur,&prev,&enh);encoder.set_gain_adjust(gainAdjust);}
+};
+thread_local std::unique_ptr<State> state;
+IMBE_PARAM quiet(){
+ int16_t v[8]={};const int pitch=100;v[0]=(pitch&0xFC)<<4;v[7]=(pitch&3)<<1;
+ IMBE_PARAM p{};decode_frame_vector(&p,v);p.ref_pitch=(2*pitch+79)*64;p.l_uv=p.num_harms;
+ for(int h=0;h<p.num_harms;h++)p.sa[h]=1;
+ return p;
+}
+bool map(const mbe_parms& cur,IMBE_PARAM& p){
+ if(!std::isfinite(cur.w0)||cur.w0<=0||cur.L<9||cur.L>56)return false;
+ double pitchValue=4*M_PI/cur.w0-39.5;
+ if(!std::isfinite(pitchValue))return false;
+ int pitch=(int)std::lround(std::max(0.,std::min(207.,pitchValue)));
+ int16_t vec[8]={};vec[0]=(pitch&0xFC)<<4;vec[7]=(pitch&3)<<1;
+ decode_frame_vector(&p,vec);
+ if(p.num_harms<9||p.num_harms>56||p.num_bands<3||p.num_bands>12)return false;
+ p.ref_pitch=(2*pitch+79)*64;double omega=4*M_PI/(pitch+39.5);
+ double power[56]={};bool voiced[56]={};
+ for(int h=0;h<p.num_harms;h++){
+  double at=std::max(1.,std::min((double)cur.L,(h+1)*omega/cur.w0));
+  int lo=(int)at,hi=std::min(cur.L,lo+1);double f=at-lo;
+  double amp=((1-f)*cur.Ml[lo]+f*cur.Ml[hi])*spectralScale;
+  if(!std::isfinite(amp)||amp<0)return false;
+  amp=std::min(30000.,amp);p.sa[h]=std::max(1,(int)std::lround(amp));
+  power[h]=amp*amp;voiced[h]=cur.Vl[std::max(1,std::min(cur.L,(int)std::lround(at)))];
+ }
+ int bandBits=0,unvoiced=0;
+ for(int band=0;band<p.num_bands;band++){
+  int start=band*3,end=(band==p.num_bands-1)?p.num_harms:std::min(start+3,(int)p.num_harms);
+  double v=0,u=0;for(int h=start;h<end;h++)(voiced[h]?v:u)+=power[h];
+  bool decision=v>u;bandBits=(bandBits<<1)|decision;
+  for(int h=start;h<end;h++){p.v_uv_dsn[h]=decision;if(!decision)unvoiced++;}
+ }
+ p.b_vec[1]=bandBits;p.l_uv=unvoiced;return true;
+}
+}
+void configure(bool on,float scale,float gain){
+ if(!std::isfinite(scale)||scale<=0||scale>16||!std::isfinite(gain)||gain<0||gain>4)
+  throw std::invalid_argument("Invalid direct AMBE-to-IMBE scale/gain");
+ active=on;spectralScale=scale;gainAdjust=gain;
+}
+bool enabled(){return active;}
+void reset(){state.reset(new State());}
+bool convert(const uint8_t* ambe,uint8_t* imbe){
+ if(!ambe||!imbe)return false;if(!state)reset();
+ uint8_t input[9];std::memcpy(input,ambe,9);char bits[49]={};
+ int errors=state->unpack.decodeBits(input,bits);
+ int bad=errors>3?2:mbe_decodeAmbe2450Parms(bits,&state->cur,&state->prev);
+ IMBE_PARAM p{};bool valid=bad==0&&map(state->cur,p);
+ if(valid){mbe_moveMbeParms(&state->cur,&state->prev);state->last=p;state->hasLast=true;state->losses=0;}
+ else {
+  state->losses=std::min(4U,state->losses+1);
+  if(state->hasLast&&state->losses<=3){p=state->last;for(int h=0;h<p.num_harms;h++)p.sa[h]=std::max(1,p.sa[h]>>state->losses);}
+  else {p=quiet();mbe_initMbeParms(&state->cur,&state->prev,&state->enh);state->hasLast=false;}
+ }
+ int16_t vec[8]={};state->encoder.encode_parameters(&p,vec);std::memset(imbe,0,11);unsigned bit=0;
+ for(int v=0;v<8;v++){int width=v<4?12:(v<7?11:7);for(int j=width-1;j>=0;j--,bit++)imbe[bit/8]|=((vec[v]>>j)&1)<<(7-bit%8);}
+ return valid;
+}
+}
