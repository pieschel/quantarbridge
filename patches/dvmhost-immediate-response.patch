+bool rewriteMotorolaArsTargetIpPacket(const uint8_t* data, uint32_t length, uint32_t targetRid, std::vector<uint8_t>& output)
+{
+    if (data == nullptr || length < 34U || data[0U] != 0x45U || data[9U] != 0x11U) {
+        return false;
+    }
+
+    const uint16_t srcPort = (static_cast<uint16_t>(data[20U]) << 8) | data[21U];
+    const uint16_t dstPort = (static_cast<uint16_t>(data[22U]) << 8) | data[23U];
+    if (srcPort != 4005U || dstPort != 4005U) {
+        return false;
+    }
+
+    const uint8_t* udpPayload = data + 28U;
+    const uint32_t udpPayloadLength = length - 28U;
+    if (udpPayloadLength < 6U || udpPayload[0U] != 0x00U || udpPayload[2U] != 0x72U) {
+        return false;
+    }
+
+    const uint32_t sourceLen = udpPayload[3U];
+    const uint32_t targetLenOffset = 4U + sourceLen;
+    if (sourceLen == 0U || sourceLen > 10U || targetLenOffset >= udpPayloadLength) {
+        return false;
+    }
+
+    const std::string sourceText(reinterpret_cast<const char*>(udpPayload + 4U), sourceLen);
+    if (sourceText.find_first_not_of("0123456789") != std::string::npos) {
+        return false;
+    }
+
+    const std::string targetText = std::to_string(targetRid);
+    if (targetText.empty() || targetText.size() > 10U) {
+        return false;
+    }
+
+    std::vector<uint8_t> payload;
+    payload.reserve(5U + sourceText.size() + targetText.size());
+    payload.push_back(0x00U);
+    payload.push_back(0x00U);
+    payload.push_back(0x72U);
+    payload.push_back(static_cast<uint8_t>(sourceText.size()));
+    payload.insert(payload.end(), sourceText.begin(), sourceText.end());
+    payload.push_back(static_cast<uint8_t>(targetText.size()));
+    payload.insert(payload.end(), targetText.begin(), targetText.end());
+    payload[1U] = static_cast<uint8_t>(payload.size() - 2U);
+
+    const uint32_t packetLength = 28U + static_cast<uint32_t>(payload.size());
+    if (packetLength > 0xFFFFU) {
+        return false;
+    }
+
+    output.assign(data, data + std::min<uint32_t>(length, 28U));
+    output.resize(packetLength, 0x00U);
+    output[2U] = static_cast<uint8_t>((packetLength >> 8) & 0xFFU);
+    output[3U] = static_cast<uint8_t>(packetLength & 0xFFU);
+    output[10U] = 0x00U;
+    output[11U] = 0x00U;
+    const uint16_t udpLength = static_cast<uint16_t>(8U + payload.size());
+    output[24U] = static_cast<uint8_t>((udpLength >> 8) & 0xFFU);
+    output[25U] = static_cast<uint8_t>(udpLength & 0xFFU);
+    output[26U] = 0x00U;
+    output[27U] = 0x00U;
+    std::copy(payload.begin(), payload.end(), output.begin() + 28U);
+
+    const uint16_t ipCsum = checksum16(output.data(), 20U);
+    output[10U] = static_cast<uint8_t>((ipCsum >> 8) & 0xFFU);
+    output[11U] = static_cast<uint8_t>(ipCsum & 0xFFU);
+
+    std::vector<uint8_t> pseudo;
+    pseudo.reserve(12U + udpLength);
+    pseudo.insert(pseudo.end(), output.begin() + 12U, output.begin() + 20U);
+    pseudo.push_back(0x00U);
+    pseudo.push_back(0x11U);
+    pseudo.push_back(static_cast<uint8_t>((udpLength >> 8) & 0xFFU));
+    pseudo.push_back(static_cast<uint8_t>(udpLength & 0xFFU));
+    pseudo.insert(pseudo.end(), output.begin() + 20U, output.end());
+    const uint16_t udpCsum = checksum16(pseudo.data(), pseudo.size());
+    output[26U] = static_cast<uint8_t>((udpCsum >> 8) & 0xFFU);
+    output[27U] = static_cast<uint8_t>(udpCsum & 0xFFU);
+    return true;
+}
