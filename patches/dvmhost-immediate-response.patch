+/* Reserve before acknowledging or mutating a narrow RF registration/ARS request. */
+bool Data::beginImmediateResponse(const char* kind, const uint8_t* request, size_t length,
+    uint32_t source, uint32_t target, ImmediateRfResponse& out)
+{
+    uint8_t header[P25_PDU_HEADER_LENGTH_BYTES] = {};
+    m_rfAssembler->dataHeader.getData(header);
+    out.key.assign(kind);
+    out.key.append(reinterpret_cast<const char*>(header), sizeof(header));
+    out.key.append(reinterpret_cast<const char*>(&source), sizeof(source));
+    out.key.append(reinterpret_cast<const char*>(&target), sizeof(target));
+    out.key.append(reinterpret_cast<const char*>(request), length);
+    out.ownerRid = source;
+    if (m_immediateRetryOwned && m_immediateRetryOwner == out.key) {
+        requestImmediateReplay();
+        return false; // no second session/Ns commit for an already in-flight request.
+    }
+    for (const auto& queued : m_immediateResponses)
+        if (queued.key == out.key)
+            return false; // exact duplicate remains owned by the existing queue item.
+    const size_t reserve = out.key.size() + 2U * (P25_PDU_FRAME_LENGTH_BYTES + 1U);
+    const bool isRetry = ::strcmp(kind, "RETRY") == 0;
+    // Keep room for the in-flight owner's one retry even behind queued new owners.
+    const size_t retryReserve = m_immediateRetryOwned && !isRetry ? m_immediateRetryResponse.accountedBytes : 0U;
+    const size_t countLimit = m_immediateRetryOwned && !isRetry ? 15U : 16U;
+    if (m_immediateResponses.size() >= countLimit || reserve > 65536U - m_immediateResponseBytes ||
+        retryReserve > 65536U - m_immediateResponseBytes - reserve) {
+        LogWarning(LOG_RF, P25_PDU_STR ", RF response not accepted: deferred capacity busy, llId = %u", source);
+        return false;
+    }
+    out.accountedBytes = reserve;
+    return true;
+}
+
+void Data::commitImmediateResponse(ImmediateRfResponse&& response)
+{
+    size_t bytes = response.key.size();
+    for (const auto& pdu : response.pdus)
+        bytes += pdu.bytes.size();
+    assert(response.pdus.size() <= 2U && bytes <= response.accountedBytes);
+    m_immediateResponseBytes += response.accountedBytes;
+    m_immediateResponses.push_back(std::move(response));
+}
+
+void Data::forgetImmediateRetry()
+{
+    m_immediateRetryOwned = false;
+    m_immediateRetryOwner.clear();
+    m_immediateRetryNs = -1;
+    m_immediateRetryAckMs = 0U;
+    m_immediateRetryResponse = ImmediateRfResponse();
+    ++m_immediateRetryGeneration;
+}
+
+bool Data::immediateRetryAckMatches(uint32_t ownerRid, uint8_t ns) const
+{
+    return !m_immediateRetryOwned || (ownerRid == m_immediateRetryRid &&
+        (m_immediateRetryNs < 0 || m_immediateRetryNs == (ns & 0x07U)));
+}
+
+bool Data::hasPendingImmediateSession(uint32_t ownerRid) const
+{
+    return std::any_of(m_immediateResponses.begin(), m_immediateResponses.end(),
+        [&](const ImmediateRfResponse& item) { return item.ownerRid == ownerRid &&
+            !item.retryIncrement && !item.retryClear; });
+}
+
+/* One cached original bundle is retained while its confirmed PDU owns the retry
+ * slot. Exact request repeats replay that bundle without a second state commit. */
+void Data::requestImmediateReplay()
+{
+    if (!m_immediateRetryOwned)
+        return;
+    if (m_retryCount >= MAX_PDU_RETRY_CNT) {
+        requestImmediateRetry(m_immediateRetryRid, false);
+        return;
+    }
+    for (const auto& queued : m_immediateResponses)
+        if ((queued.retryIncrement || queued.retryClear) &&
+            queued.retryGeneration == m_immediateRetryGeneration)
+            return; // at most one resend/NACK for the in-flight owner.
+    const auto& cached = m_immediateRetryResponse;
+    if (m_immediateResponses.size() >= 16U || cached.accountedBytes > 65536U - m_immediateResponseBytes) {
+        LogWarning(LOG_RF, P25_PDU_STR ", scoped duplicate replay deferred capacity busy, llId = %u", m_immediateRetryRid);
+        return;
+    }
+    ImmediateRfResponse replay = cached;
+    replay.retryIncrement = true;
+    replay.retryGeneration = m_immediateRetryGeneration;
+    commitImmediateResponse(std::move(replay));
+}
+
+void Data::requestImmediateRetry(uint32_t ownerRid, bool validateNs)
+{
+    if (ownerRid != m_immediateRetryRid) {
+        LogWarning(LOG_RF, P25_PDU_STR ", scoped retry owner mismatch, llId = %u", ownerRid);
+        return;
+    }
+    if (validateNs && !immediateRetryAckMatches(ownerRid, m_rfAssembler->dataHeader.getResponseStatus()))
+        return;
+    for (const auto& queued : m_immediateResponses)
+        if ((queued.retryIncrement || queued.retryClear) &&
+            queued.retryGeneration == m_immediateRetryGeneration)
+            return;
+    ImmediateRfResponse response;
+    if (!beginImmediateResponse("RETRY", m_retryPDUData, (m_retryPDUBitLength + 7U) / 8U,
+        ownerRid, ownerRid, response))
+        return;
+    response.retryGeneration = m_immediateRetryGeneration;
+    if (m_retryCount < MAX_PDU_RETRY_CNT) {
+        response.preamble = true;
+        response.retryIncrement = true;
+        writeRF_PDU(m_retryPDUData, m_retryPDUBitLength, false, true, true, &response);
+    } else {
+        response.retryClear = true;
+        writeRF_PDU_Ack_Response(PDUAckClass::NACK, PDUAckType::NACK_UNDELIVERABLE,
+            m_rfAssembler->dataHeader.getNs(), ownerRid, false,
+            m_rfAssembler->dataHeader.getSrcLLId(), &response);
+    }
+    commitImmediateResponse(std::move(response));
+}
+
+/* Only new owned confirmed responses use this existing P25 link-ACK timeout.
+ * No RF NACK is fabricated when a locally observed ACK wait expires. */
+void Data::queueImmediateTimeoutRetry()
+{
+    for (const auto& queued : m_immediateResponses)
+        if ((queued.retryIncrement || queued.retryClear) &&
+            queued.retryGeneration == m_immediateRetryGeneration)
+            return;
+    const auto& cached = m_immediateRetryResponse;
+    if (m_immediateResponses.size() >= 16U || cached.accountedBytes > 65536U - m_immediateResponseBytes)
+        return; // expired stays pending; no retry budget is consumed.
+    ImmediateRfResponse retry;
+    retry.key = cached.key;
+    retry.ownerRid = cached.ownerRid;
+    retry.expectedAckNs = cached.expectedAckNs;
+    retry.preamble = true;
+    retry.retryIncrement = true;
+    retry.retryGeneration = m_immediateRetryGeneration;
+    retry.accountedBytes = cached.accountedBytes;
+    for (const auto& original : cached.pdus) {
+        if (!original.ackRetry && original.trackRetry) {
+            ImmediateRfPdu pdu = original;
+            pdu.ackRetry = true;
+            pdu.leadingTdus = 0U; // retry confirmed PDU, not its prior link ACK.
+            pdu.imm = false;
+            retry.pdus.push_back(std::move(pdu));
+        }
+    }
+    commitImmediateResponse(std::move(retry));
+}
+
+/* Main Control::clock calls processNetwork before this drain. RF process is
+ * serialized by the same recursive Data mutex; the writer only needs queueLock. */
+bool Data::serviceImmediateResponses(uint32_t ms)
+{
+    if (m_immediateResponses.empty() && !m_immediateRetryOwned)
+        return false;
+    if (deferMotorolaDataForNetworkVoice() || m_p25->m_netState != RS_NET_IDLE ||
+        m_p25->m_rfState != RS_RF_LISTENING)
+        return true;
+    {
+        std::lock_guard<std::mutex> queueLock(Control::s_queueLock);
+        if (!m_p25->m_txQueue.isEmpty() || !m_p25->m_txImmQueue.isEmpty() ||
+            (m_p25->m_rfTimeout.isRunning() && m_p25->m_rfTimeout.hasExpired()))
+            return true; // queued tail and RF busy pause the owned ACK budget.
+    }
+    if (m_immediateRetryOwned) {
+        const bool retryPending = std::any_of(m_immediateResponses.begin(), m_immediateResponses.end(),
+            [&](const ImmediateRfResponse& item) { return (item.retryIncrement || item.retryClear) &&
+                item.retryGeneration == m_immediateRetryGeneration; });
+        if (!retryPending) {
+            if (m_immediateRetryAckMs > ms)
+                m_immediateRetryAckMs -= ms;
+            else {
+                m_immediateRetryAckMs = 0U;
+                if (m_retryCount < MAX_PDU_RETRY_CNT)
+                    queueImmediateTimeoutRetry();
+                else {
+                    LogWarning(LOG_RF, P25_PDU_STR ", scoped confirmed response failed: link ACK timeout after retries, llId = %u, n = %d",
+                        m_immediateRetryRid, m_immediateRetryNs);
+                    delete[] m_retryPDUData; m_retryPDUData = nullptr;
+                    m_retryPDUBitLength = 0U; m_retryCount = 0U;
+                    forgetImmediateRetry();
+                }
+            }
+        }
+    }
+    if (m_immediateResponses.empty())
+        return m_immediateRetryOwned; // protect the current slot from timed producers.
+    // A second confirmed owner may not replace a buffer awaiting its RF ACK.
+    // Its current owner's retry/NACK must still pass that blocked queue head.
+    const auto needsSlot = [](const ImmediateRfResponse& item) {
+        if (item.retryIncrement || item.retryClear) return false;
+        for (const auto& pdu : item.pdus)
+            if (!pdu.ackRetry && pdu.trackRetry) return true;
+        return false;
+    };
+    auto selected = m_immediateResponses.begin();
+    if (m_immediateRetryOwned && needsSlot(*selected)) {
+        selected = std::find_if(m_immediateResponses.begin(), m_immediateResponses.end(),
+            [&](const ImmediateRfResponse& item) { return !needsSlot(item); });
+        if (selected == m_immediateResponses.end())
+            return true;
+    }
+    auto& response = *selected;
+    if ((response.retryIncrement || response.retryClear) &&
+        (!m_immediateRetryOwned || response.retryGeneration != m_immediateRetryGeneration)) {
+        m_immediateResponseBytes -= response.accountedBytes;
+        m_immediateResponses.erase(selected); // retry canceled by an ACK or newer tracked owner.
+        return true;
+    }
+    struct Frame { std::vector<uint8_t> bytes; bool imm; };
+    std::vector<Frame> frames;
+    const auto tdu = [&](bool imm) {
+        if (!m_p25->m_duplex) return;
+        Frame f {std::vector<uint8_t>(P25_TDU_FRAME_LENGTH_BYTES + 2U, 0U), imm};
+        f.bytes[0] = modem::TAG_EOT;
+        Sync::addP25Sync(f.bytes.data() + 2U);
+        m_p25->m_nid.encode(f.bytes.data() + 2U, DUID::TDU);
+        P25Utils::setStatusBitsAllIdle(f.bytes.data() + 2U, P25_TDU_FRAME_LENGTH_BITS);
+        frames.push_back(std::move(f));
+    };
+    if (response.preamble && !m_p25->m_isModemDFSI && !m_p25->m_modem->hasTX() && !m_p25->m_ccRunning) {
+        const unsigned count = std::min<unsigned>(m_p25->m_tduPreambleCount, 64U /* Control::writeRF_Preamble limit */);
+        for (unsigned i = 0; i < count; ++i) tdu(false);
+    }
+    for (const auto& pdu : response.pdus) {
+        for (unsigned i = 0; i < pdu.leadingTdus; ++i) tdu(pdu.imm);
+        tdu(pdu.imm);
+        for (unsigned i = 0; i < 5U; ++i) {
+            Frame f {std::vector<uint8_t>(27U, 0U), false};
+            f.bytes[0] = modem::TAG_EOT;
+            frames.push_back(std::move(f));
+        }
+        if (m_p25->m_duplex) {
+            Frame f {std::vector<uint8_t>(P25_PDU_FRAME_LENGTH_BYTES + 2U, 0U), pdu.imm};
+            const uint32_t bits = P25Utils::encodeByLength(pdu.bytes.data(), f.bytes.data() + 2U, pdu.bitLength);
+            f.bytes.resize((bits + 7U) / 8U + 2U);
+            f.bytes[0] = modem::TAG_DATA;
+            Sync::addP25Sync(f.bytes.data() + 2U);
+            m_p25->m_nid.encode(f.bytes.data() + 2U, DUID::PDU);
+            P25Utils::addStatusBits(f.bytes.data() + 2U, bits, pdu.inbound, true);
+            P25Utils::setStatusBitsStartIdle(f.bytes.data() + 2U);
+            frames.push_back(std::move(f));
+        }
+        tdu(pdu.imm);
+    }
+    size_t normal = 0U, immediate = 0U;
+    for (const auto& f : frames) (f.imm ? immediate : normal) += f.bytes.size() + 2U;
+    // Allocate all ownership state before any frame is admitted to the host queue.
+    UInt8Array nextRetry;
+    uint32_t nextRetryBits = 0U;
+    ImmediateRfResponse nextOwner;
+    std::string nextOwnerKey;
+    if (needsSlot(response)) {
+        for (const auto& pdu : response.pdus) {
+            if (!pdu.ackRetry && pdu.trackRetry) {
+                assert(nextRetryBits == 0U); // this narrow response has one confirmed PDU.
+                nextRetry = UInt8Array(new uint8_t[pdu.bytes.size()]);
+                ::memcpy(nextRetry.get(), pdu.bytes.data(), pdu.bytes.size());
+                nextRetryBits = pdu.bitLength;
+            }
+        }
+        nextOwner = response;
+        nextOwnerKey = response.key;
+    }
+    std::lock_guard<std::mutex> queueLock(Control::s_queueLock);
+    if (!m_p25->m_txQueue.isEmpty() || !m_p25->m_txImmQueue.isEmpty() ||
+        (m_p25->m_rfTimeout.isRunning() && m_p25->m_rfTimeout.hasExpired()))
+        return true;
+    // Never resize or purge an occupied queue. Empty queues can reserve the full
+    // batch, with a spare byte because this ring represents full==empty.
+    if (m_p25->m_txQueue.freeSpace() <= normal) m_p25->m_txQueue.resize(normal + 1U);
+    if (m_p25->m_txImmQueue.freeSpace() <= immediate) m_p25->m_txImmQueue.resize(immediate + 1U);
+    for (const auto& f : frames) {
+        auto& queue = f.imm ? m_p25->m_txImmQueue : m_p25->m_txQueue;
+        const uint8_t length[2] = {static_cast<uint8_t>(f.bytes.size() >> 8U), static_cast<uint8_t>(f.bytes.size())};
+        const bool a = queue.addData(length, 2U), b = queue.addData(f.bytes.data(), f.bytes.size());
+        assert(a && b); (void)a; (void)b;
+    }
+    if (nextRetryBits != 0U) {
+        assert(!m_immediateRetryOwned);
+        forgetImmediateRetry();
+        // Preserve the old immediate writer's replacement of an unowned legacy
+        // retry buffer; only newly scoped in-flight owners are protected.
+        delete[] m_retryPDUData;
+        m_retryPDUData = nextRetry.release();
+        m_retryPDUBitLength = nextRetryBits;
+        m_retryCount = 0U;
+        m_immediateRetryOwned = true;
+        m_immediateRetryOwner.swap(nextOwnerKey);
+        m_immediateRetryRid = response.ownerRid;
+        m_immediateRetryNs = response.expectedAckNs;
+        m_immediateRetryAckMs = kMotorolaTmsP25FragmentAckTimeoutMs;
+        m_immediateRetryResponse = std::move(nextOwner);
+    }
+    if (response.retryIncrement) {
+        ++m_retryCount;
+        m_immediateRetryAckMs = kMotorolaTmsP25FragmentAckTimeoutMs;
+    }
+    if (response.retryClear) {
+        delete[] m_retryPDUData; m_retryPDUData = nullptr;
+        m_retryPDUBitLength = 0U; m_retryCount = 0U; forgetImmediateRetry();
+        auto session = m_motorolaSessions.find(response.ownerRid);
+        if (!hasPendingImmediateSession(response.ownerRid) &&
+            session != m_motorolaSessions.end() && session->second.pendingTmsFragmentAck)
+            resetMotorolaTmsInboundDelivery(session->second);
+    }
+    m_immediateResponseBytes -= response.accountedBytes;
+    m_immediateResponses.erase(selected);
+    return true;
+}
