+std::string trimCandidate(const std::string& value)
+{
+    const auto begin = value.find_first_not_of(' ');
+    if (begin == std::string::npos) {
+        return {};
+    }
+    const auto end = value.find_last_not_of(' ');
+    return value.substr(begin, end - begin + 1U);
+}
