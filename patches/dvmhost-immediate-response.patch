+/* Defer timed Motorola data until network voice and its queued tail finish. */
+bool Data::deferMotorolaDataForNetworkVoice()
+{
+    if (m_p25->m_netState == RS_NET_AUDIO) {
+        m_motorolaNetworkVoiceDrainPending = true;
+        return true;
+    }
+    if (!m_motorolaNetworkVoiceDrainPending)
+        return false;
+    if (m_p25->m_netState != RS_NET_IDLE)
+        return true;
+    std::lock_guard<std::mutex> lock(Control::s_queueLock);
+    if (!m_p25->m_txQueue.isEmpty() || !m_p25->m_txImmQueue.isEmpty())
+        return true;
+    m_motorolaNetworkVoiceDrainPending = false;
+    return false;
+}
